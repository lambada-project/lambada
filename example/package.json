{
  "name": "lambada-example",
  "main": "src/index.ts",
  "private": true,
  "scripts": {
    "test": "bash scripts/test.sh",
    "typecheck": "tsc --noEmit",
    "build:www": "npm --prefix src/www ci && npm --prefix src/www run build",
    "preview": "npm run build:www && pulumi preview",
    "deploy": "npm run build:www && pulumi up"
  },
  "//": "dependencies are uploaded with every function; deploy-time packages belong in devDependencies",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "~3.981.0",
    "@aws-sdk/client-sns": "~3.981.0",
    "@aws-sdk/client-sqs": "~3.981.0",
    "@aws-sdk/util-dynamodb": "~3.981.0",
    "@lambada/utils": "^2.4.5"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.0.0",
    "@aws-sdk/client-kms": "~3.981.0",
    "@aws-sdk/client-s3": "~3.981.0",
    "@lambada/core": "^1.42.0",
    "@pulumi/aws": "^7.0.0",
    "@pulumi/awsx": "^3.0.0",
    "@pulumi/pulumi": "^3.113.0",
    "@types/aws-lambda": "^8.10.152",
    "@types/bun": "^1.2.20",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.2",
    "zod": "^4.4.3"
  }
}
