{
  "name": "@lambada/utils",
  "version": "2.4.5",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./handler": {
      "types": "./dist/handler.d.ts",
      "import": "./dist/esm/handler.js",
      "require": "./dist/handler.js"
    },
    "./request": {
      "types": "./dist/request.d.ts",
      "import": "./dist/esm/request.js",
      "require": "./dist/request.js"
    },
    "./cors": {
      "types": "./dist/cors.d.ts",
      "import": "./dist/esm/cors.js",
      "require": "./dist/cors.js"
    },
    "./users": {
      "types": "./dist/users.d.ts",
      "import": "./dist/esm/users.js",
      "require": "./dist/users.js"
    },
    "./repository": {
      "types": "./dist/repository.d.ts",
      "import": "./dist/esm/repository.js",
      "require": "./dist/repository.js"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "import": "./dist/esm/error.js",
      "require": "./dist/error.js"
    },
    "./package.json": "./package.json",
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/esm/*.js",
      "require": "./dist/*.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/esm/*.js",
      "require": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lambada-project/lambada.git",
    "directory": "packages/utils"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Juan C. Andreu",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'},null,2))\"",
    "test": "jest"
  },
  "license": "MIT",
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "~3.981.0",
    "@aws-sdk/client-dynamodb": "~3.981.0",
    "@aws-sdk/client-secrets-manager": "~3.981.0",
    "@aws-sdk/util-dynamodb": "~3.981.0",
    "@types/aws-lambda": "^8.10.72",
    "@types/bun": "^1.2.20",
    "@types/node": "^22.0.0",
    "bun": "^1.2.20",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "~3.981.0",
    "@aws-sdk/client-dynamodb": "~3.981.0",
    "@aws-sdk/client-secrets-manager": "~3.981.0",
    "@aws-sdk/util-dynamodb": "~3.981.0",
    "@types/aws-lambda": "^8.10.152"
  },
  "description": "",
  "gitHead": "487cc342922d5e6fc5a1e9b2d8737f744c6e032c"
}
