{
    "compilerOptions": {
        "strict": true,
        "outDir": "bin",
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "sourceMap": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "types": ["node", "bun"]
    },
    "include": ["src", "test"]
}
