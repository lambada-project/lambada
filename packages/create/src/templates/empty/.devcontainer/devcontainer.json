{
	"name": "{{PROJECT_NAME}}",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"remoteUser": "node",
	// Your AWS config, read-only. It is mounted beside ~/.aws, which stays writable for AWS Emulator.
	"mounts": [
		"source=${localEnv:HOME}/.aws,target=/home/node/.aws-host,type=bind,readonly"
	],
	"containerEnv": {
		"AWS_CONFIG_FILE": "/home/node/.aws-host/config",
		"AWS_SHARED_CREDENTIALS_FILE": "/home/node/.aws-host/credentials"
	},
	"postCreateCommand": "npm install",
	"customizations": {
		"vscode": {
			"extensions": [
				"oven.bun-vscode",
				"pulumi.pulumi-lsp-client"
			]
		}
	}
}
